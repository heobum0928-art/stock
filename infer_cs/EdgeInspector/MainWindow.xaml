<Window x:Class="EdgeInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeAI Vision Studio" Height="820" Width="1320"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource WindowBg}">

    <DockPanel LastChildFill="True">
        <!-- 상단 브랜드 바 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="52">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource Accent}">
                    <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="EdgeAI" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="Vision Studio" FontSize="13" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="7,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 올인원 탭 -->
        <TabControl x:Name="Tabs">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="홈" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="가이드" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="① 라벨링" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="② 학습" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="③ 객체 검출" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Warning}" VerticalAlignment="Center" />
                        <TextBlock Text="③ 이상탐지" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="세그 라벨링" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" />
                        <TextBlock Text="③ 세그멘테이션" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
