<UserControl x:Class="EdgeInspector.Views.AnomalyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EdgeInspector.Views">
    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InvBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis" />
        <local:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Background="{StaticResource ContentBg}">

        <!-- 가이드 헤더 -->
        <Border DockPanel.Dock="Top" Padding="24,18,24,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource Warning}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="이상탐지" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="이상탐지 (Anomaly Detection)" Style="{StaticResource H1}" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Text="정상 제품만 학습해 결함을 찾습니다(라벨 불필요). 결함 위치는 히트맵, 종합 판정은 OK/NG. 임계값으로 민감도를 조절하세요." />
            </StackPanel>
        </Border>

        <!-- 툴바 -->
        <Border DockPanel.Dock="Top" Padding="24,0,24,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="제품 모델" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModelName}"
                          Width="140" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ToolTip="제품 라인마다 이상탐지 모델을 따로 학습했다면 여기서 검사할 모델을 전환하세요." />
                <Button Style="{StaticResource SecondaryButton}" Click="DeleteModel_Click" Padding="8,7" Margin="0,0,20,0"
                        ToolTip="선택한 제품 모델을 삭제합니다(학습 체크포인트·로그 포함, 되돌릴 수 없음).">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Click="OpenImage_Click" Margin="0,0,10,0"
                        ToolTip="검사할 이미지 한 장을 엽니다. 열면 자동으로 검사(히트맵+OK/NG)됩니다.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="이미지 열기" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,10,0"
                        ToolTip="검사할 이미지가 든 폴더를 통째로 열어 왼쪽 갤러리에 채웁니다. 갤러리에서 한 장씩 클릭하면 바로 검사됩니다(여러 장 연속 검사).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="폴더 열기(여러 장)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Click="TrainNew_Click" Margin="0,0,20,0" IsEnabled="{Binding IsTraining, Converter={StaticResource InvBool}}"
                        ToolTip="내 제품의 '양품(정상)' 이미지만 든 폴더를 골라 이상탐지 모델을 새로 만듭니다. 라벨(박스) 필요 없습니다. 코그넥스/키엔스의 '양품만 등록' 방식과 동일."
                        Visibility="{Binding IsTraining, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="양품 폴더로 새 모델 학습" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="CancelTrain_Click" Margin="0,0,20,0" ToolTip="진행 중인 학습을 중단합니다."
                        Visibility="{Binding IsTraining, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Background" Value="{StaticResource Danger}" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="학습 취소" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <CheckBox Content="히트맵 표시" IsChecked="{Binding ShowHeatmap}" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Text="임계(민감도)" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                <Slider Minimum="0" Maximum="1" Value="{Binding Threshold}" Width="160" VerticalAlignment="Center"
                        ToolTip="오른쪽으로 밀면 둔감(웬만해선 OK), 왼쪽으로 밀면 민감(조금만 달라도 NG). 실시간으로 판정이 바뀝니다." />
                <TextBlock Text="{Binding Threshold, StringFormat={}{0:F2}}" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Body}" />
                <TextBlock Text="{Binding TrainStatus}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
            </StackPanel>
        </Border>

        <!-- 상태줄 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBg}" Padding="24,8">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
        </Border>

        <!-- 갤러리 + 이미지 + 판정 패널 -->
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="224" />
            </Grid.ColumnDefinitions>

            <!-- 샘플 갤러리 -->
            <DockPanel Grid.Column="0" Background="{StaticResource SidebarBg}">
                <TextBlock DockPanel.Dock="Top" Text="샘플 갤러리" Style="{StaticResource SectionLabel}" Margin="12,14,0,8" />
                <ListBox ItemsSource="{Binding Thumbnails}" SelectedItem="{Binding SelectedThumb}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" ToolTip="마우스를 올리면 파일명이 보입니다.">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="72" />
                            <Setter Property="Margin" Value="3,3" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{StaticResource CardBg}" CornerRadius="5"
                                                BorderBrush="Transparent" BorderThickness="2" Padding="3">
                                            <Image Source="{Binding Image}" Stretch="Uniform" Height="54" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,0" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,12,14,8">
                        <TextBlock Text="검사 이미지 + 이상 히트맵 (휠=줌, 드래그=팬)" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="8,0" VerticalAlignment="Center"
                                   Visibility="{Binding ImageFileName, Converter={StaticResource StringToVis}}" />
                        <!-- 읽기전용 TextBox — 파일명을 드래그로 선택해 복사할 수 있게(NG인데 OK로 나온
                             샘플 등을 리포트할 때 파일명이 필요하다는 사장님 피드백 반영). -->
                        <TextBox Text="{Binding ImageFileName, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource TextPrimary}" FontSize="12"
                                 VerticalAlignment="Center" Cursor="IBeam" Padding="0" MaxWidth="500"
                                 ToolTip="{Binding ImagePath}" />
                    </StackPanel>
                    <Grid Margin="14,0,14,14" Background="Transparent" local:ZoomPan.Enabled="True">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                        <Image Source="{Binding Heatmap}" Stretch="Uniform" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 판정 사이드 패널 -->
            <StackPanel Grid.Column="2" Margin="12,12,14,0">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="판정" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        <Border Background="{Binding VerdictColor}" CornerRadius="8" Margin="0,10,0,8" Height="72">
                            <TextBlock Text="{Binding Verdict}" Foreground="White" FontSize="38" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ScoreFraction, Mode=OneWay}"
                                     Foreground="{Binding VerdictColor}" Height="7" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                        <!-- 판정이 틀렸을 때(과검/미검) 파일명을 직접 복사할 필요 없이 버튼 한 번으로
                             처리 — 과검(양품인데 NG)은 양품 폴더에 추가해 재학습에 바로 쓰고,
                             미검(불량인데 OK)은 절대 양품 폴더에 넣지 않고 별도 회귀테스트
                             목록에만 기록한다(정반대 처리 — 헷갈리면 안 됨). -->
                        <Button Style="{StaticResource SecondaryButton}" Click="AddRetrainCandidate_Click" Margin="0,10,0,0"
                                HorizontalContentAlignment="Center"
                                ToolTip="과검(過檢): 지금 이 이미지가 사실은 양품인데 NG로 잘못 나왔다면, 재학습용 양품 폴더에 바로 추가합니다.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="재학습 후보 추가" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddConfirmedDefect_Click" Margin="0,8,0,0"
                                HorizontalContentAlignment="Center"
                                ToolTip="미검(未檢): 지금 이 이미지가 실제 불량인데 OK로 잘못 나왔다면, 확인된 미검 목록에 기록합니다(양품 폴더엔 넣지 않음 — 나중에 모델을 바꿀 때마다 이 목록으로 재현율을 확인).">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="미검(실제불량) 기록" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="히트맵 읽는 법" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="빨강/주황이 진할수록 정상 패턴과 다른 부분(결함 후보)입니다. 점수가 임계값을 넘으면 NG로 판정합니다." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
