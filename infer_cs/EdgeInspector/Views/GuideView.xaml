<UserControl x:Class="EdgeInspector.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource ContentBg}">
        <StackPanel Margin="32,28,32,40" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="가이드 — 처음부터 끝까지" FontFamily="Segoe UI, Malgun Gothic"
                       FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0"
                       Text="이 분야를 몰라도 순서대로 따라 하면 됩니다. 한 번에 끝나지 않고, 돌릴수록 좋아지는 '반복 루프'입니다." />

            <!-- 전체 흐름 -->
            <TextBlock Text="전체 흐름" Style="{StaticResource H2}" Margin="0,28,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                        <Run Text="① 라벨링" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <Run Text="  →  " Foreground="{StaticResource TextMuted}" />
                        <Run Text="② 학습" FontWeight="Bold" Foreground="{StaticResource Success}" />
                        <Run Text="  →  " Foreground="{StaticResource TextMuted}" />
                        <Run Text="③ 객체 검출/이상탐지/세그멘테이션" FontWeight="Bold" Foreground="{StaticResource Warning}" />
                        <Run Text="  →  " Foreground="{StaticResource TextMuted}" />
                        <Run Text="④ 부족한 부분 보완" FontWeight="Bold" />
                        <Run Text="  →  다시 ①" Foreground="{StaticResource TextMuted}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="핵심: 처음 정확도가 낮은 건 당연합니다. 검사에서 '뭘 틀리는지' 보고, 그 부분 데이터를 더 모아 다시 학습하는 걸 반복하면 계속 좋아집니다." />
                </StackPanel>
            </Border>

            <!-- ① 라벨링 -->
            <TextBlock Text="① 라벨링 — 컴퓨터에게 정답 알려주기" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="'① 라벨링' 탭 → [이미지 폴더 열기] → 찾을 대상의 이름(클래스) 입력 → 이미지 위에서 대상을 감싸듯 드래그." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                        <Run Text="요령:" FontWeight="Bold" />
                        <Run Text=" • 대상을 딱 맞게 감싸기(배경이 너무 많이 들어가지 않게)  • 같은 종류는 항상 같은 클래스로  • 애매한 건 규칙을 정해 일관되게  • 휠로 확대하면 정밀하게 그릴 수 있음  • 최소 클래스당 수십~수백 장" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ② 학습 -->
            <TextBlock Text="② 학습 — 모델 만들기" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="라벨링 탭에서 [데이터셋 내보내기]를 누르면 '② 학습' 탭에 자동으로 연결됩니다. 이름을 확인하고 [학습 시작]." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                        <Run Text="요령:" FontWeight="Bold" />
                        <Run Text=" • 처음엔 '빠르게 확인만'을 켜서 파이프라인이 도는지 점검  • 잘 되면 그 체크를 " />
                        <Run Text="끄고" FontWeight="Bold" Foreground="{StaticResource Warning}" />
                        <Run Text=" 정식 학습(정확도는 정식 학습에서 나옵니다)  • 학습곡선(mAP50)이 오르다 평평해지면 충분히 학습된 것" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ③ 검사·평가 -->
            <TextBlock Text="③ 검사·평가 — 잘 됐는지 확인" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="'홈'에서 방금 만든 모델 카드를 클릭 → 종류에 맞는 탭(객체 검출/이상탐지/세그멘테이션)으로 이동 → 이미지를 열어 결과 확인." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}">
                        <Run Text="확인 방법:" FontWeight="Bold" />
                        <Run Text=" • [정답(GT) 비교] 체크 → 점선(정답) vs 실선(예측)으로 뭘 놓치는지 눈으로 확인  • Score 슬라이더로 민감도 조절  • 데이터가 충분히 모였으면 홈 화면의 '모델 상태 점검' 버튼으로 신호등 종합 평가도 가능" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 성능 개선 -->
            <TextBlock Text="④ 성능이 안 나올 때 — 증상별 처방" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Background="{StaticResource SidebarBg}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="증상" Style="{StaticResource SectionLabel}" Margin="14,10" />
                        <TextBlock Grid.Column="1" Text="원인" Style="{StaticResource SectionLabel}" Margin="0,10" />
                        <TextBlock Grid.Column="2" Text="처방" Style="{StaticResource SectionLabel}" Margin="0,10" />
                    </Grid>
                    <StackPanel>
                        <Grid Margin="0" Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="못 잡는 게 많다(미검출)" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,10" />
                            <TextBlock Grid.Column="1" Text="데이터 부족 / Score 높음" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10" />
                            <TextBlock Grid.Column="2" Text="그 대상 이미지·라벨 더 모으기 · Score 슬라이더 낮추기" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,14,10" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="엉뚱한 걸 잡는다(오탐)" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,10" />
                            <TextBlock Grid.Column="1" Text="Score 낮음 / 배경 헷갈림" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10" />
                            <TextBlock Grid.Column="2" Text="Score 올리기 · 헷갈리는 배경 이미지도 함께 라벨링" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,14,10" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="특정 클래스만 못 잡음" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,10" />
                            <TextBlock Grid.Column="1" Text="클래스 불균형" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10" />
                            <TextBlock Grid.Column="2" Text="그 클래스 데이터 집중 보강(건강검진에서 불균형 확인)" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,14,10" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="테스트는 잘 되는데 현장은 안 됨" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,10" />
                            <TextBlock Grid.Column="1" Text="도메인 갭" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10" />
                            <TextBlock Grid.Column="2" Text="실제 현장 조명·카메라로 찍은 데이터로 다시 학습" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,14,10" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="전반적으로 정확도가 낮다" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="14,10" />
                            <TextBlock Grid.Column="1" Text="데이터 양·라벨 품질" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10" />
                            <TextBlock Grid.Column="2" Text="데이터 더 모으기 · '빠르게 확인만' 껐는지 확인 · 라벨 다시 점검" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,14,10" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 성능 5원칙 -->
            <TextBlock Text="성능 높이는 핵심 5가지 (효과 큰 순서)" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="1. 데이터 양" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="  — 압도적으로 제일 큽니다. 클래스당 수백~수천 장을 목표로." /></TextBlock>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="2. 라벨 품질" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="  — 정확하고 일관되게. 사람이 애매하게 라벨링하면 모델도 애매해집니다." /></TextBlock>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="3. 다양성" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="  — 실제 현장의 여러 조명·각도·불량 유형을 골고루 포함." /></TextBlock>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="4. 클래스 균형" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="  — 한 클래스만 너무 적으면 그것만 못 잡습니다." /></TextBlock>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"><Run Text="5. 정식 학습" FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text="  — '빠르게 확인만'을 끄고 충분한 에폭으로 학습." /></TextBlock>
                </StackPanel>
            </Border>

            <!-- 다음 단계 -->
            <TextBlock Text="다음 단계 (상용화로 가려면)" Style="{StaticResource H2}" Margin="0,24,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• 지금은 공개 데이터셋 위주 — 실제 검사할 라인의 사진을 직접 모으는 것이 1순위입니다." />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• 검사기의 진짜 기준은 정확도(mAP)보다 '불량을 놓치는 비율(재현율)'입니다. 목표치를 재현율로 잡으세요." />
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="• 배포 → 실패 사례 수집 → 재학습의 반복 루프를 계속 돌리는 것이 상용 품질로 가는 길입니다." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
