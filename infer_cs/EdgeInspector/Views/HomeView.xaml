<UserControl x:Class="EdgeInspector.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource ContentBg}">
        <StackPanel Margin="32,28,32,32">

            <!-- 환영 헤더 -->
            <TextBlock Text="EdgeAI Vision Studio" FontFamily="Segoe UI, Malgun Gothic"
                       FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" FontSize="13"
                       Text="데이터만 있으면 라벨링 → 학습 → 검사까지 한 곳에서. 산업용 비전 AI를 코드 없이." />

            <!-- 워크플로우 3단계 (Button — Tab+Enter로 키보드 접근 가능) -->
            <TextBlock Text="워크플로우" Style="{StaticResource H2}" Margin="0,28,0,12" />
            <UniformGrid Rows="1" Columns="3">
                <UniformGrid.Resources>
                    <Style TargetType="Button" x:Key="WorkflowCard">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cb" Style="{StaticResource Card}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cb" Property="Background" Value="{StaticResource CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <Button Style="{StaticResource WorkflowCard}" Margin="0,0,8,0" Click="StepLabel_Click">
                    <StackPanel>
                        <TextBlock Text="①  라벨링" Style="{StaticResource H2}" Foreground="{StaticResource Accent}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="라벨 없는 이미지에 박스를 그려 학습 데이터를 만듭니다." />
                        <TextBlock Text="라벨링 탭으로 이동 →" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource WorkflowCard}" Margin="8,0,8,0" Click="StepTrain_Click">
                    <StackPanel>
                        <TextBlock Text="②  학습" Style="{StaticResource H2}" Foreground="{StaticResource Success}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="폴더를 고르고 버튼 하나로 학습합니다. 하이퍼파라미터는 자동 최적화." />
                        <TextBlock Text="학습 탭으로 이동 →" Style="{StaticResource Caption}" Foreground="{StaticResource Success}" Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource WorkflowCard}" Margin="8,0,0,0" Click="StepInspect_Click">
                    <StackPanel>
                        <TextBlock Text="③  검사" Style="{StaticResource H2}" Foreground="{StaticResource Warning}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="학습 결과를 이미지 위에 오버레이해 눈으로 확인합니다." />
                        <TextBlock Text="아래 모델을 클릭하세요 ↓" Style="{StaticResource Caption}" Foreground="{StaticResource Warning}" Margin="0,10,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- 추가 도구(옛 '학습 스튜디오' 런처를 흡수 — 이제 이 앱 하나로 전부) -->
            <TextBlock Text="추가 도구" Style="{StaticResource H2}" Margin="0,28,0,12" />
            <StackPanel Orientation="Horizontal">
                <Button Click="WebcamDemo_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Padding="16,10"
                        ToolTip="웹캠으로 실시간 검출·추적·통과계수를 시연합니다(별도 창). COCO 사전학습 모델 사용.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="웹캠 실시간 데모" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="HealthCheck_Click" Style="{StaticResource SecondaryButton}" Padding="16,10"
                        ToolTip="학습된 모델들을 신호등(🟢정상/🟡보완필요/🔴문제)으로 점검해 '지금 써도 되는지'를 리포트로 보여줍니다.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="모델 상태 점검" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 처음 켠 사용자용 안내(학습된 모델이 하나도 없을 때만) -->
            <Border Margin="0,24,0,0" Padding="18,16" CornerRadius="8"
                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    Visibility="{Binding NoTrainedModels, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="👋  처음이신가요? 이렇게 시작하세요" Style="{StaticResource H2}" Foreground="{StaticResource Accent}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"
                               Text="아직 학습된 모델이 없습니다. 위 '① 라벨링'부터 순서대로 진행하면 됩니다: 이미지에 박스를 그려(①) → 학습하고(②) → 결과를 확인(③)합니다. 자세한 순서와 요령은 상단 '가이드' 탭을 보세요." />
                    <TextBlock Text="막히면 '가이드' 탭 참고 · 성능 높이는 법도 거기 있습니다" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- 내 모델 -->
            <StackPanel Orientation="Horizontal" Margin="0,32,0,12">
                <TextBlock Text="내 모델" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="12,3,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="300" Margin="0,0,14,14" Click="Card_Click" Tag="{Binding}" Cursor="Hand"
                                HorizontalContentAlignment="Stretch" Opacity="{Binding CardOpacity}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cb" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="16">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cb" Property="Background" Value="{StaticResource CardHover}" />
                                            <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding TypeColor}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding Metric}" Foreground="{StaticResource TextPrimary}" FontSize="14"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Border Background="{StaticResource BorderBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                            Margin="8,0,0,0" Visibility="{Binding NotTrained, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="미학습" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H2}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
