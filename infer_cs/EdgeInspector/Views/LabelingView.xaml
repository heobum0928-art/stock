<UserControl x:Class="EdgeInspector.Views.LabelingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EdgeInspector.Views"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <!-- 루트를 Grid로 감싸 코치(화살표+말풍선) 오버레이가 모든 것 위에 겹쳐지게 한다. -->
    <Grid>
        <DockPanel LastChildFill="True" Background="{StaticResource ContentBg}">

            <!-- 툴바 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenFolderBtn" Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click" Margin="0,0,16,0"
                            ToolTip="라벨링할 이미지들이 들어있는 폴더를 선택합니다. (하위 폴더까지 전부 찾습니다)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="이미지 폴더 열기" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding FolderInfo}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}"
                               Text="드래그=박스 그리기 · 휠=확대/축소 · 우클릭드래그=이동 · Del=선택박스 삭제 · Ctrl+Z=마지막 취소 · F=화면 맞춤" />
                </StackPanel>
            </Border>

            <!-- 상태줄 -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <!-- ① 사이드바: 가이드 + 클래스 + 내보내기 -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">
                        <TextBlock Text="가이드" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text=" 폴더 열기" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text=" 클래스 확인/추가" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding AnyBoxDrawn, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding AnyBoxDrawn, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text=" 박스 그리기" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding Exported, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding Exported, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Text=" 데이터셋 내보내기" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                        <TextBlock Text="클래스 (그릴 종류)" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"
                                   ToolTip="더블클릭하면 이름을 바꿀 수 있습니다. 클릭하면 그 클래스가 선택되어 다음에 그리는 박스에 적용됩니다." />
                        <TextBlock Text="더블클릭=이름변경, 클릭=선택" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Classes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="0,3" MouseLeftButtonUp="ClassRow_Click" Tag="{Binding}"
                                            ToolTip="클릭=이 클래스 선택 · 더블클릭=이름 변경">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Color}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text=" ●" Foreground="{StaticResource Accent}" FontSize="9" VerticalAlignment="Center"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewClassBox" VerticalContentAlignment="Center" Height="30"
                                     Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}"
                                     KeyDown="NewClassBox_KeyDown" ToolTip="새 클래스 이름을 입력하고 Enter 또는 [+]를 누르세요. 예: 결함, 사람, 헬멧" />
                            <Button Grid.Column="1" Content="+" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0"
                                    Click="AddClass_Click" ToolTip="새 클래스 추가" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                        <TextBlock Text="내보내기 → 학습" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                        <TextBlock Text="표시 이름(한글 가능)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                                 Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,8"
                                 ToolTip="뷰어와 홈 화면에 표시될 이름입니다. 한글로 자유롭게 지어도 됩니다. 예: 반도체 백라이트 검사" />
                        <TextBlock Text="산출물 이름(영문/숫자)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OutName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                                 Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,10"
                                 ToolTip="폴더/파일 이름으로 쓰입니다. 영문·숫자·밑줄(_)만 가능합니다. 예: backlight_check" />
                        <Button x:Name="ExportBtn" Content="데이터셋 내보내기" Style="{StaticResource PrimaryButton}" Click="Export_Click"
                                IsEnabled="{Binding HasFolder}"
                                ToolTip="지금까지 그린 박스를 학습용 데이터셋으로 정리합니다. 끝나면 '학습' 탭에서 바로 학습을 시작할 수 있습니다." />

                        <!-- 내보내기 완료 후 계속 보이는 안내 배너 — 확인창은 닫으면 사라지므로,
                             사장님이 나중에 다시 이 탭을 봐도 다음 할 일을 잊지 않게 상시 표시한다. -->
                        <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                Visibility="{Binding Exported, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="✓ 데이터셋 준비 완료 → 위 '② 학습' 탭에서 시작하세요"
                                       Foreground="White" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ② 갤러리 -->
                <DockPanel Grid.Column="1" Background="{StaticResource SidebarBg}">
                    <TextBlock DockPanel.Dock="Top" Text="이미지" Style="{StaticResource SectionLabel}" Margin="12,14,0,8" />
                    <ListBox ItemsSource="{Binding Thumbnails}" SelectedItem="{Binding SelectedThumb}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False" ToolTip="클릭하면 그 이미지가 오른쪽에 열립니다(현재 이미지는 자동 저장됨).">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="72" />
                                <Setter Property="Margin" Value="3,3" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="{StaticResource CardBg}" CornerRadius="5"
                                                    BorderBrush="Transparent" BorderThickness="2" Padding="3">
                                                <Image Source="{Binding Image}" Stretch="Uniform" Height="54" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <!-- ③ 그리기 캔버스 -->
                <Border x:Name="ViewerBorder" Grid.Column="2" Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,1,0" ClipToBounds="True">
                    <Grid x:Name="ViewerGrid">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="'이미지 폴더 열기'로 시작하세요" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        </StackPanel>
                        <Grid x:Name="ZoomGrid" Margin="16" Background="Transparent" RenderTransformOrigin="0,0">
                            <Image x:Name="BaseImage" Source="{Binding Image}" Stretch="Uniform" />
                            <Image Source="{Binding BoxOverlay}" Stretch="Uniform" IsHitTestVisible="False" />
                            <Canvas x:Name="DrawCanvas" Background="Transparent"
                                    MouseLeftButtonDown="DrawCanvas_MouseDown" MouseMove="DrawCanvas_MouseMove"
                                    MouseLeftButtonUp="DrawCanvas_MouseUp" />
                        </Grid>
                        <!-- 확대 배율 표시(작게, 우하단) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                                Background="#CC232830" CornerRadius="5" Padding="8,4"
                                Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="ZoomLabel" Text="100%" Style="{StaticResource Caption}" FontSize="11" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ④ 박스 목록 -->
                <DockPanel Grid.Column="3" Background="{StaticResource SidebarBg}">
                    <TextBlock DockPanel.Dock="Top" Text="이 이미지의 박스 (Del로 삭제)" Style="{StaticResource SectionLabel}" Margin="14,14,14,8" TextWrapping="Wrap" />
                    <ListBox x:Name="BoxList" ItemsSource="{Binding BoxItems}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="BoxList_KeyDown"
                             ToolTip="지금 열려있는 이미지에 그린 박스 목록입니다. 선택 후 Del 키로 삭제할 수 있습니다.">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" Background="{StaticResource CardBg}" CornerRadius="5" Margin="8,3" Padding="10,8"
                                                    BorderBrush="Transparent" BorderThickness="2">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="2"
                                                            Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding ClassName}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- 코치 오버레이(화살표+말풍선) — 클릭을 가로채지 않게 IsHitTestVisible=False -->
        <Canvas x:Name="CoachCanvas" IsHitTestVisible="False" />
    </Grid>
</UserControl>
