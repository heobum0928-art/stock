<UserControl x:Class="EdgeInspector.Views.RingGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="76" Height="76">
    <Grid>
        <Ellipse x:Name="TrackRing" Stroke="{DynamicResource BorderBrush}" StrokeThickness="7" />
        <Path x:Name="ProgressArc" Stroke="{DynamicResource Accent}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <TextBlock x:Name="CenterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
    </Grid>
</UserControl>
