<UserControl x:Class="EdgeInspector.Views.SegLabelingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EdgeInspector.Views"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis" />
        <local:InverseBoolConverter x:Key="InvBool" />
        <local:EnumToVisibilityConverter x:Key="EnumVis" />

        <!-- 도구/모양 선택용 칩(RadioButton) — 눌리면 강조색 배경 -->
        <Style x:Key="ToolChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource ContentBg}">

        <!-- 툴바 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenFolderBtn" Style="{StaticResource PrimaryButton}" Click="OpenFolder_Click" Margin="0,0,16,0"
                            ToolTip="세그멘테이션(에지) 라벨링할 이미지들이 들어있는 폴더를 선택합니다.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="이미지 폴더 열기" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding FolderInfo}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <Button Style="{StaticResource SecondaryButton}" Click="Undo_Click" Padding="9,5" Margin="0,0,10,0"
                            IsEnabled="{Binding CanUndo}"
                            Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}"
                            ToolTip="가장 최근에 그린 것(폴리곤/브러쉬 한 번의 칠) 하나를 취소하고 이전 상태로 되돌립니다. (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="실행 취소" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 도구(폴리곤/브러쉬/매직브러쉬)와 무관하게 항상 보임 — 이미지를 선택한 직후(기본
                         도구=폴리곤)에도 그 이미지에 이미 칠해진 브러쉬 내용을 바로 지울 수 있어야 함. -->
                    <Button Style="{StaticResource SecondaryButton}" Click="ClearBrush_Click" Padding="9,5" Margin="0,0,20,0"
                            Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}"
                            ToolTip="지금 이 이미지에서 브러쉬(매직브러쉬·AI 초안 포함)로 칠해진 부분을 전부 지웁니다(폴리곤은 그대로).">
                        <TextBlock Text="브러쉬 전체 지우기" FontSize="12" />
                    </Button>

                    <!-- 도구 선택: 폴리곤 / 브러쉬 / 매직브러쉬 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                        <RadioButton x:Name="ToolPolygonRadio" GroupName="segtool" Style="{StaticResource ToolChip}"
                                     Content="폴리곤" IsChecked="True" Checked="ToolPolygon_Checked"
                                     ToolTip="클릭으로 점을 찍어 각진 경계를 그립니다(기존 방식)." />
                        <RadioButton x:Name="ToolBrushRadio" GroupName="segtool" Style="{StaticResource ToolChip}"
                                     Content="브러쉬" Checked="ToolBrush_Checked"
                                     ToolTip="색칠하듯 드래그해서 칠합니다. 자유형 결함(얼룩·긁힘 등)에 적합." />
                        <RadioButton x:Name="ToolMagicRadio" GroupName="segtool" Style="{StaticResource ToolChip}"
                                     Content="매직브러쉬" Checked="ToolMagic_Checked" Margin="0,0,16,0"
                                     ToolTip="클릭한 지점과 색이 비슷한 인접 영역을 자동으로 채웁니다(새 모델 불필요, 색이 뚜렷한 결함에 효과적)." />
                    </StackPanel>
                </StackPanel>

                <!-- 브러쉬 전용 옵션 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Tool, Converter={StaticResource EnumVis}, ConverterParameter=Brush}">
                    <TextBlock Text="모양" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <RadioButton x:Name="ShapeCircleRadio" GroupName="brushshape" Style="{StaticResource ToolChip}"
                                 Content="원형" IsChecked="True" Checked="ShapeCircle_Checked" />
                    <RadioButton x:Name="ShapeSquareRadio" GroupName="brushshape" Style="{StaticResource ToolChip}"
                                 Content="사각형" Checked="ShapeSquare_Checked" Margin="0,0,16,0" />
                    <TextBlock Text="크기" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Minimum="2" Maximum="150" Value="{Binding BrushSize}" Width="130" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BrushSize, StringFormat={}{0:F0}px}" Style="{StaticResource Body}"
                               VerticalAlignment="Center" Margin="8,0,16,0" />
                    <CheckBox Content="지우개" IsChecked="{Binding IsErasing}" VerticalAlignment="Center" Margin="0,0,16,0"
                               ToolTip="켜면 브러쉬/매직브러쉬가 칠하는 대신 지웁니다." />
                </StackPanel>

                <!-- 매직브러쉬 전용 옵션 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Tool, Converter={StaticResource EnumVis}, ConverterParameter=MagicWand}">
                    <TextBlock Text="허용치(색이 얼마나 비슷해야 하는지)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Minimum="1" Maximum="120" Value="{Binding MagicTolerance}" Width="150" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MagicTolerance}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="8,0,16,0" />
                    <CheckBox Content="지우개" IsChecked="{Binding IsErasing}" VerticalAlignment="Center" Margin="0,0,16,0"
                               ToolTip="켜면 클릭한 영역과 비슷한 색을 칠하는 대신 지웁니다." />
                </StackPanel>

                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}"
                           Text="폴리곤: 클릭=점 찍기 · 더블클릭/Enter=닫기 · Esc=취소 · Del=선택 삭제  ·  브러쉬/매직브러쉬: 클릭(또는 드래그)=칠하기  ·  공통: 휠=확대 · 우클릭드래그=이동 · Ctrl+Z=실행 취소" />
            </StackPanel>
        </Border>

        <!-- 상태줄 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <!-- ① 사이드바 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,16,16">
                    <TextBlock Text="가이드" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}" />
                        <TextBlock Text=" 폴더 열기" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding AnyMaskDrawn, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding AnyMaskDrawn, Converter={StaticResource InvBoolToVis}}" />
                        <TextBlock Text=" 영역 칠하기(폴리곤/브러쉬)" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="{StaticResource Accent}" Visibility="{Binding Saved, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="○" Foreground="{StaticResource TextMuted}" Visibility="{Binding Saved, Converter={StaticResource InvBoolToVis}}" />
                        <TextBlock Text=" 마스크 저장" Style="{StaticResource Caption}" Margin="4,0,0,0" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                    <TextBlock Text="그리는 법" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="폴리곤: 결함 테두리를 따라 클릭으로 점을 찍고 더블클릭/Enter로 닫으세요(각진 경계에 적합)." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="브러쉬: 색칠하듯 드래그하며 칠하세요. 크기/모양(원형·사각형) 조절 가능, 지우개로 되돌립니다(자유형 결함에 적합)." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="매직브러쉬: 결함 위를 클릭하면 비슷한 색의 인접 영역을 자동으로 채웁니다(얼룩·변색처럼 색이 뚜렷할 때 빠름). 세 방식을 섞어 써도 됩니다." />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="AI 보조" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="몇십~백 장 정도 손으로 라벨링한 뒤 학습하면, 나머지 이미지는 AI가 초안을 채워주고 사람은 다듬기만 하면 됩니다." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,2">
                        <Run Text="이 폴더에서 라벨링: " /><Run Text="{Binding FolderLabeledCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="/" /><Run Text="{Binding Thumbnails.Count, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="장" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" FontSize="11">
                        <Run Text="(AI 학습 전체 풀: " /><Run Text="{Binding LabeledCount, Mode=OneWay}" /><Run Text="장 — 예전에 다른 폴더에서 라벨링한 것도 포함될 수 있음)" />
                    </TextBlock>
                    <Button Content="AI로 학습하기" Style="{StaticResource SecondaryButton}" Click="TrainDraft_Click" Margin="0,0,0,6"
                            IsEnabled="{Binding IsTrainingDraft, Converter={StaticResource InvBool}}"
                            Visibility="{Binding IsTrainingDraft, Converter={StaticResource InvBoolToVis}}"
                            ToolTip="지금까지 라벨링한 이미지들로 AI 보조 모델을 학습합니다(수 분 소요, 진행 중에도 다른 이미지 라벨링 계속 가능)." />
                    <Button Content="학습 취소" Click="CancelTrainDraft_Click" Margin="0,0,0,6"
                            Visibility="{Binding IsTrainingDraft, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Background" Value="{StaticResource Danger}" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding DraftTrainStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="AI 초안 채우기" Style="{StaticResource PrimaryButton}" Click="ApplyAiDraft_Click"
                            IsEnabled="{Binding HasDraftModel}"
                            ToolTip="학습된 AI 보조 모델로 지금 열려있는 이미지의 결함 후보를 브러쉬 레이어에 미리 채웁니다. 이후 브러쉬/지우개로 다듬으세요(폴리곤은 그대로)." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasDraftModel, Converter={StaticResource InvBoolToVis}}"
                               Text="아직 학습된 모델이 없습니다. 위 버튼으로 먼저 학습하세요." />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                    <TextBlock Text="저장" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="이 이미지에 결함이 없으면 폴리곤 없이 그냥 저장해도 됩니다('결함 없음'으로 저장됨)." />
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="8,6" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap">
                            <Run Text="⚠ 저장 위치는 항상 고정: " />
                            <Run Text="{Binding SaveDestinationPath, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <LineBreak />
                            <Run Text="(이미지를 어느 폴더에서 열었든 상관없이 항상 여기로 저장됩니다)" />
                        </TextBlock>
                    </Border>
                    <Button x:Name="SaveMaskBtn" Content="마스크 저장" Style="{StaticResource PrimaryButton}" Click="SaveMask_Click"
                            IsEnabled="{Binding HasFolder}"
                            ToolTip="지금 그린 폴리곤들을 흑백 마스크 이미지로 저장합니다. train/data/images·masks에 쌓여 '세그멘테이션' 학습에 바로 쓰입니다." />

                    <Border Background="{StaticResource Accent}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding Saved, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✓ 저장 완료 → 다음 이미지로 넘어가거나, train/train.py로 학습하세요"
                                   Foreground="White" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ② 갤러리 -->
            <DockPanel Grid.Column="1" Background="{StaticResource SidebarBg}">
                <TextBlock DockPanel.Dock="Top" Text="이미지" Style="{StaticResource SectionLabel}" Margin="12,14,0,2" />
                <TextBlock DockPanel.Dock="Top" Text="Ctrl/Shift+클릭=여러 장 선택" Style="{StaticResource Caption}" FontSize="10" Margin="12,0,0,6" />
                <Button x:Name="ClearSelectedBtn" DockPanel.Dock="Top" Click="ClearSelected_Click"
                        Margin="10,0,10,8" Padding="6,5" FontSize="11" Visibility="Collapsed"
                        ToolTip="선택한 이미지들의 저장된 마스크를 한 번에 지웁니다(이미지 자체는 남고 라벨만 지워짐, 되돌릴 수 없음).">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Background" Value="{StaticResource Danger}" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </Button.Style>
                </Button>
                <ListBox x:Name="GalleryList" ItemsSource="{Binding Thumbnails}" SelectedItem="{Binding SelectedThumb}"
                         SelectionMode="Extended" SelectionChanged="GalleryList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" ToolTip="클릭하면 그 이미지가 오른쪽에 열립니다. Ctrl/Shift+클릭으로 여러 장 선택 가능.">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="72" />
                            <Setter Property="Margin" Value="3,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{StaticResource CardBg}" CornerRadius="5"
                                                BorderBrush="Transparent" BorderThickness="2" Padding="3">
                                            <Image Source="{Binding Image}" Stretch="Uniform" Height="54" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- ③ 그리기 캔버스 -->
            <Border x:Name="ViewerBorder" Grid.Column="2" Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,1,0" ClipToBounds="True">
                <Grid x:Name="ViewerGrid">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="'이미지 폴더 열기'로 시작하세요" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                    <Grid x:Name="ZoomGrid" Margin="16" Background="Transparent" RenderTransformOrigin="0,0">
                        <Image x:Name="BaseImage" Source="{Binding Image}" Stretch="Uniform" />
                        <Image Source="{Binding MaskOverlay}" Stretch="Uniform" IsHitTestVisible="False" />
                        <Image Source="{Binding BrushOverlay}" Stretch="Uniform" IsHitTestVisible="False" />
                        <Canvas x:Name="DrawCanvas" Background="Transparent"
                                MouseLeftButtonDown="DrawCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="DrawCanvas_MouseLeftButtonUp"
                                MouseMove="DrawCanvas_MouseMove" />
                    </Grid>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"
                            Background="#CC232830" CornerRadius="5" Padding="8,4"
                            Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Style="{StaticResource Caption}" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <!-- ④ 폴리곤 목록 -->
            <DockPanel Grid.Column="3" Background="{StaticResource SidebarBg}">
                <TextBlock DockPanel.Dock="Top" Text="이 이미지의 폴리곤 (Del로 삭제)" Style="{StaticResource SectionLabel}" Margin="14,14,14,8" TextWrapping="Wrap" />
                <ListBox x:Name="PolygonList" ItemsSource="{Binding PolygonItems}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="PolygonList_KeyDown"
                         ToolTip="지금 열려있는 이미지에 그린 폴리곤 목록입니다. 선택 후 Del 키로 삭제할 수 있습니다.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{StaticResource CardBg}" CornerRadius="5" Margin="8,3" Padding="10,8"
                                                BorderBrush="Transparent" BorderThickness="2">
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
