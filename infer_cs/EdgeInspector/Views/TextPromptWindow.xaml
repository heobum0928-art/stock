<Window x:Class="EdgeInspector.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이름 변경" Height="150" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBg}" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptLabel" Text="새 이름:" Style="{StaticResource Body}" Margin="0,0,0,8" />
        <TextBox x:Name="Input" Height="32" VerticalContentAlignment="Center"
                 Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}"
                 BorderBrush="{StaticResource BorderBrush}" KeyDown="Input_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="취소" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="확인" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
