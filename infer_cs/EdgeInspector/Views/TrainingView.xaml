<UserControl x:Class="EdgeInspector.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EdgeInspector.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Background="{StaticResource ContentBg}">

        <!-- 상태줄 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 사이드바: 데이터셋/이름/옵션/시작 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,16,16,16">
                    <TextBlock Text="학습" Style="{StaticResource H1}" FontSize="18" Margin="0,0,0,4" />
                    <TextBlock Text="라벨링에서 만든 데이터셋(또는 직접 선택)을 학습합니다. 나머지는 자동 최적화됩니다."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="① 데이터셋 (data.yaml)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding DataYaml, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                                 Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" />
                        <Button Grid.Column="1" Content="찾기…" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0" Click="BrowseYaml_Click" />
                    </Grid>

                    <TextBlock Text="② 표시 이름(한글 가능)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                             Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                    <TextBlock Text="③ 산출물 이름(영문/숫자)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding OutName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center"
                             Background="{StaticResource CardBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                    <CheckBox Content="빠르게 확인만(작은 모델·짧은 학습)" IsChecked="{Binding Quick}" Margin="0,0,0,16" />

                    <Button Content="④ 학습 시작" Style="{StaticResource PrimaryButton}" Click="Start_Click" Padding="14,10"
                            Visibility="{Binding IsTraining, Converter={StaticResource InvBoolToVis}}" />
                    <Button Content="■ 중단" Click="Stop_Click" Padding="14,10"
                            Visibility="{Binding IsTraining, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="{StaticResource Danger}" />
                            </Style>
                        </Button.Style>
                    </Button>

                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="7" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding EtaText}" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsTraining, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 학습 곡선 + 로그 -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="#FF1E1E1E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12" Height="200">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="학습 곡선 (mAP50)" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CurveLabel}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <Grid>
                            <Path Data="{Binding CurveGeometry}" Stroke="{StaticResource Accent}" StrokeThickness="2" Stretch="Fill" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Background="#FF1E1E1E">
                    <DockPanel Margin="16">
                        <TextBlock DockPanel.Dock="Top" Text="로그" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Log}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
